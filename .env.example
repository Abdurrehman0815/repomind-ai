# RepoMind AI Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# ─────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret_key

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://repomind:repomind_password@localhost:5432/repomind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─────────────────────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────────────────────

# LLM Provider: 'ollama' (local) or 'bedrock' (Phase 32+ only)
LLM_PROVIDER=ollama

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=4096

# Embedding
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ─────────────────────────────────────────────────────────────
# AWS BEDROCK — DO NOT CONFIGURE UNTIL PHASE 32
# ─────────────────────────────────────────────────────────────

# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MAX_TOKENS=4096
# BEDROCK_TIMEOUT=120

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────

# Base directory for repository workspaces (must be an absolute path)
WORKSPACE_ROOT=/data/workspaces

# Maximum file size to index in MB
MAX_FILE_SIZE_MB=10

# Tool execution timeout in seconds
TOOL_EXECUTION_TIMEOUT=60

# Maximum tool output size in characters
TOOL_OUTPUT_MAX_CHARS=50000

# ─────────────────────────────────────────────────────────────
# RETRIEVAL
# ─────────────────────────────────────────────────────────────

RETRIEVAL_TOP_K_VECTOR=20
RETRIEVAL_TOP_K_KEYWORD=20
RETRIEVAL_TOP_K_FINAL=8
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=RepoMind AI

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
