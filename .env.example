# RepoMind AI Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to the repository.

# ─────────────────────────────────────────────────────────────
# CORE
# ─────────────────────────────────────────────────────────────

ENVIRONMENT=development
DEBUG=false

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_secret_key

# ─────────────────────────────────────────────────────────────
# DATABASE
# ─────────────────────────────────────────────────────────────

DATABASE_URL=postgresql+asyncpg://repomind:repomind_password@localhost:5432/repomind
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─────────────────────────────────────────────────────────────
# AI PROVIDERS
# ─────────────────────────────────────────────────────────────

# LLM Provider: 'ollama' (local, slow on CPU) or 'azure_foundry' (hosted, fast)
LLM_PROVIDER=ollama

# Azure AI Foundry (used when LLM_PROVIDER=azure_foundry)
# LLM_PROVIDER=azure_foundry
# LLM_ENDPOINT=https://<your-resource>.services.ai.azure.com
# LLM_API_KEY=<key from Foundry portal>
# LLM_MODEL=<deployment name, e.g. claude-haiku-4-5>
# LLM_API_STYLE=anthropic   # 'anthropic' for Claude deployments, 'openai' for GPT/other models

# Ollama (local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=120
OLLAMA_MAX_TOKENS=4096
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=6144
ANSWER_MAX_TOKENS=700
PROMPT_CONTEXT_CHUNKS=6
PROMPT_CHUNK_MAX_CHARS=4000

# Embedding
# Fast hosted option (re-import repositories after switching):
# EMBEDDING_PROVIDER=azure_foundry
# EMBEDDING_MODEL=<embedding deployment name, e.g. text-embedding-3-small>
# EMBEDDING_DIMENSIONS=768
# EMBEDDING_ENDPOINT=   # blank = reuse LLM_ENDPOINT
# EMBEDDING_API_KEY=    # blank = reuse LLM_API_KEY
# RETRIEVAL_MIN_SIMILARITY=0.2
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BATCH_SIZE=32

# ─────────────────────────────────────────────────────────────
# AWS BEDROCK — DO NOT CONFIGURE UNTIL PHASE 32
# ─────────────────────────────────────────────────────────────

# LLM_PROVIDER=bedrock
# AWS_REGION=us-east-1
# BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
# BEDROCK_MAX_TOKENS=4096
# BEDROCK_TIMEOUT=120

# ─────────────────────────────────────────────────────────────
# SECURITY
# ─────────────────────────────────────────────────────────────

# Base directory for repository workspaces (must be an absolute path)
WORKSPACE_ROOT=/data/workspaces

# Maximum file size to index in MB
MAX_FILE_SIZE_MB=10

# Tool execution timeout in seconds
TOOL_EXECUTION_TIMEOUT=60

# Maximum tool output size in characters
TOOL_OUTPUT_MAX_CHARS=50000

# ─────────────────────────────────────────────────────────────
# RETRIEVAL
# ─────────────────────────────────────────────────────────────

RETRIEVAL_TOP_K_VECTOR=20
RETRIEVAL_TOP_K_KEYWORD=20
RETRIEVAL_TOP_K_FINAL=8
RERANKER_ENABLED=false
RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ─────────────────────────────────────────────────────────────
# FRONTEND
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://localhost:8000
VITE_APP_NAME=RepoMind AI

# ─────────────────────────────────────────────────────────────
# CORS
# ─────────────────────────────────────────────────────────────

CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ─────────────────────────────────────────────────────────────
# OBSERVABILITY
# ─────────────────────────────────────────────────────────────

LOG_LEVEL=INFO
LOG_FORMAT=json
ENABLE_REQUEST_LOGGING=true
